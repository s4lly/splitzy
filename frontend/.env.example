# Frontend Environment Variables
# Copy this file to .env and fill in your actual values
#
# For local development, you can also create .env.local to override specific values
# Priority: .env.local > .env
#
# Note: Both VITE_ and REACT_APP_ prefixes are supported (see vite.config.ts envPrefix)

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API URL
REACT_APP_API_URL=http://localhost:5001/api

# Environment: development, preview, or production
VITE_VERCEL_ENV=development

# Base URL the OG-preview serverless function (api/og-receipt.js) calls to
# fetch receipt data from the Flask backend. Runs in the Vercel Node runtime
# (process.env, not VITE_). Defaults to https://splitzy-prod.onrender.com when
# unset, so prod needs no value; set it only to point preview/non-prod at a
# different backend.
# BACKEND_URL=

# =============================================================================
# VERCEL DEVELOPMENT SERVER
# =============================================================================

# Port for `vercel dev` command (default: 3001)
# Set to avoid conflict with zero-query service on port 3000
VERCEL_DEV_PORT=3001

# Vercel Blob Storage token (required for image uploads in development)
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# AUTHENTICATION (Clerk)
# =============================================================================

# Get this from https://dashboard.clerk.com (Publishable Key, not Secret Key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# =============================================================================
# ZERO SYNC (Optional - for real-time sync features)
# =============================================================================

# Zero cache/query/mutate URLs (leave empty to disable Zero features)
# VITE_ZERO_CACHE_URL=
# VITE_ZERO_QUERY_URL=
# VITE_ZERO_MUTATE_URL=

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================

# PostHog analytics (leave empty to disable)
# REACT_APP_POSTHOG_PROJECT_API_KEY=

# =============================================================================
# LEGACY RECEIPT ID CUTOFF
# =============================================================================

# ISO timestamp (with timezone) — anonymous viewers can resolve legacy
# /receipts/:id links only for receipts created before this moment. Should
# agree with backend LEGACY_ID_CUTOFF_ISO. Leave empty to block all anonymous
# legacy-id lookups. Inlined by Vite at build time — changing it requires a
# frontend rebuild/redeploy, not just an env change.
# VITE_LEGACY_ID_CUTOFF_ISO=2026-01-01T00:00:00Z
