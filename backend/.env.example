# Backend Environment Variables
# Copy this file to .env and fill in your actual values
#
# For local development, you can also create .env.local to override specific values
# Priority: .env.local > .env

# =============================================================================
# DATABASE
# =============================================================================

# Local Docker PostgreSQL (recommended for development)
DATABASE_URL=postgresql://postgres:pass@localhost:5432/splitzy

# Alternative: Neon cloud database (for staging/production)
# NEON_DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/splitzy?sslmode=require

# =============================================================================
# AUTHENTICATION (Clerk)
# =============================================================================

# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret_here

# Comma-separated list of frontend origins that Clerk trusts as valid JWT issuers.
# Used to configure authorized_parties on every authenticate_request() call.
# Include all origins the frontend can be served from (local dev + deployed URLs).
CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app,http://localhost:5173

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Vercel serverless function URL for image upload
# In development, use localhost:3001 (default port for vercel dev)
VERCEL_FUNCTION_URL=http://localhost:3001/api/upload-to-blob

# Google API key for Gemini image analysis
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_flask_secret_key_here

# When true, a receipt subtotal mismatch triggers one targeted Gemini retry
# with arithmetic hints. Set to false/0/no to disable retries without a deploy.
RECEIPT_RETRY_ON_MISMATCH=true

# Server port
PORT=5001

# Environment: development, preview, or production
VERCEL_ENV=development

# CORS allowed origins (comma-separated, only used in production)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Number of trusted proxies in front of the app (ProxyFix x_for hop count).
# Must match the deployment's proxy chain so get_remote_address resolves to the
# real client IP for rate limiting: too low and all clients collapse to the
# proxy IP; too high and clients can spoof X-Forwarded-For. Render only = 1;
# add a CDN/WAF (e.g. Cloudflare) in front = 2. Defaults to 1 if unset.
# PROXY_FIX_X_FOR=1

# Opt-in diagnostic: when truthy, exposes GET /debug/proxy which reports the raw
# X-Forwarded-For chain and hop_count so you can tune PROXY_FIX_X_FOR. Off by
# default (it exposes client IPs) — enable temporarily, measure, then disable.
# DEBUG_PROXY_ENDPOINT=true

# =============================================================================
# RATE LIMITING
# =============================================================================

# Redis (e.g. Render Key Value) backing store for Flask-Limiter counters.
# REQUIRED in production so per-process counters can't be sidestepped by
# horizontal scaling; the app refuses to start in production without it. When
# unset outside production, the limiter falls back to in-memory ("memory://").
# REDIS_URL=redis://localhost:6379

# =============================================================================
# LEGACY RECEIPT ID CUTOFF
# =============================================================================

# ISO-8601 timestamp WITH timezone (e.g. 2026-01-01T00:00:00Z). Receipts created
# before this moment may be reached via the legacy /receipts/:id surface;
# everything newer must use the unguessable share_token. REQUIRED in production
# (startup fails without it); in dev it defaults to epoch 0 so all legacy-id
# lookups 404 unless explicitly set. Must match the frontend's
# VITE_LEGACY_ID_CUTOFF_ISO.
# LEGACY_ID_CUTOFF_ISO=2026-01-01T00:00:00Z
